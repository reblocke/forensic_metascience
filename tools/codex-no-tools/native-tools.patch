+#[tokio::test]
+async fn model_tools_deny_all_prevents_catalogue_code_mode_worker() {
+    use crate::tools::registry::ToolRegistry;
+    use codex_extension_api::ToolPolicy;
+    let (_, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).tool_mode = Some(ToolMode::CodeModeOnly);
+    });
+    let registry = ToolRegistry::with_tool_policy(Arc::new(ToolPolicy {
+        allowed_tools: Some(Vec::new()),
+        ..Default::default()
+    }));
+    let router = ToolRouter::from_registry(
+        &turn,
+        turn.model_info(),
+        registry,
+        Vec::new(),
+        &Default::default(),
+    );
+    assert!(router.model_visible_specs().is_empty());
+    assert!(!router.requires_code_mode_worker());
+    for value in [
+        serde_json::json!({"type": "tool_search_call", "call_id": "denied", "execution": "client", "arguments": {"invalid": true}}),
+        serde_json::json!({"type": "web_search_call", "status": "completed"}),
+        serde_json::json!({"type": "image_generation_call", "status": "completed", "result": "synthetic"}),
+    ] {
+        let item = serde_json::from_value(value).expect("valid response item shape");
+        assert!(matches!(router.build_tool_call_with_policy(item),
+            Err(crate::function_tool::FunctionCallError::Fatal(message))
+                if message == "Model tools are disabled by startup policy."));
+    }
+}
