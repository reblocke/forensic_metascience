+#[tokio::test]
+async fn model_tools_deny_all_fails_fatally_before_handlers() {
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let readiness = Arc::new(AtomicUsize::new(0));
+    let mut registry = ToolRegistry::with_tool_policy(Arc::new(codex_extension_api::ToolPolicy {
+        allowed_tools: Some(Vec::new()),
+        ..Default::default()
+    }));
+    registry.register_trusted(Arc::new(ReadinessTestHandler {
+        handler: TestHandler {
+            tool_name: codex_tools::ToolName::plain("exec"),
+        },
+        readiness_waits: Arc::clone(&readiness),
+    }));
+    assert!(registry.tool_names_for_test().is_empty());
+    for name in [
+        codex_tools::ToolName::plain("exec"),
+        codex_tools::ToolName::namespaced("functions", "wait"),
+        codex_tools::ToolName::plain("apply_patch"),
+        codex_tools::ToolName::namespaced("connector", "read"),
+    ] {
+        for custom in [false, true] {
+            let mut invocation = test_invocation(
+                Arc::clone(&session),
+                Arc::clone(&turn),
+                "denied-call",
+                name.clone(),
+            );
+            if custom {
+                invocation.payload = ToolPayload::Custom {
+                    input: "TOOL_EXECUTION_SENTINEL".to_string(),
+                };
+            }
+            let error = registry
+                .dispatch_any_with_state(invocation, None)
+                .await
+                .err();
+            assert_eq!(
+                error,
+                Some(FunctionCallError::Fatal(
+                    "Model tools are disabled by startup policy.".to_string()
+                ))
+            );
+        }
+    }
+    assert_eq!(readiness.load(Ordering::Relaxed), 0);
+}
